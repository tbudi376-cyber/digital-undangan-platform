# Google Apps Script Web App URL
# Deploy your Code.gs as a Web App and paste the URL here
NEXT_PUBLIC_GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Secret key for on-demand revalidation (/api/revalidate)
REVALIDATE_SECRET=temuwaktu_secret_key_revalidate

# Password protection for admin generator portal (/generator)
ADMIN_PASSWORD=temuwaktu_admin_secret

# Base URL for metadata and canonical links
NEXT_PUBLIC_BASE_URL=https://temuwaktu.id
